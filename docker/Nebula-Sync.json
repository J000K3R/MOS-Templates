{
  "name": "Nebula-Sync",
  "repo": "ghcr.io/lovelaze/nebula-sync:latest",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped",
  "post_parameters": null,
  "web_ui_url": null,
  "readme_url": "https://j000k3r.github.io/MOS-Templates/docs/Templates/Docker/Nebula-Sync.html",
  "icon": "https://raw.githubusercontent.com/J000K3R/MOS-Templates/main/icons/nebula-sync.png",
  "category": [ "Network", "Tools" ],
  "project": "https://github.com/lovelaze/nebula-sync",
  "support": "https://github.com/lovelaze/nebula-sync/issues",
  "description": "Synchronize Pi-hole v6 instances: replicas take over block lists, allow/deny lists, groups, clients and DNS settings from the primary on a schedule. Enter PRIMARY and REPLICAS as http://IP|app-password (webserver.api.app_sudo must be enabled on every Pi-hole).",
  "donate": null,
  "paths": [],
  "ports": [],
  "variables": [
    {
      "name": "Primary",
      "key": "PRIMARY",
      "value": "http://192.168.1.2|APP_PASSWORD",
      "mask": true,
      "description": "Primary Pi-hole: http://IP|app-password."
    },
    {
      "name": "Replicas",
      "key": "REPLICAS",
      "value": "http://192.168.1.3|APP_PASSWORD",
      "mask": true,
      "description": "Replica Pi-hole(s): http://IP|app-password, separate several with a comma."
    },
    {
      "name": "Schedule",
      "key": "CRON",
      "value": "*/15 * * * *",
      "mask": false,
      "description": "Cron schedule for the sync (default every 15 minutes)."
    },
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/Vienna",
      "mask": false,
      "description": "Timezone for the schedule."
    },
    {
      "name": "Run Gravity",
      "key": "RUN_GRAVITY",
      "value": "true",
      "mask": false,
      "description": "Rebuild gravity on the replicas after a sync."
    },
    {
      "name": "Full Sync",
      "key": "FULL_SYNC",
      "value": "false",
      "mask": false,
      "description": "true = full Teleporter sync (whole config incl. webserver); false = only the parts enabled below."
    },
    {
      "name": "Sync DNS",
      "key": "SYNC_CONFIG_DNS",
      "value": "true",
      "mask": false,
      "description": "Upstreams, local DNS records, CNAMEs."
    },
    {
      "name": "Sync DHCP",
      "key": "SYNC_CONFIG_DHCP",
      "value": "false",
      "mask": false,
      "description": "DHCP settings."
    },
    {
      "name": "Sync NTP",
      "key": "SYNC_CONFIG_NTP",
      "value": "false",
      "mask": false,
      "description": "NTP settings."
    },
    {
      "name": "Sync Resolver",
      "key": "SYNC_CONFIG_RESOLVER",
      "value": "false",
      "mask": false,
      "description": "Resolver settings."
    },
    {
      "name": "Sync Database",
      "key": "SYNC_CONFIG_DATABASE",
      "value": "false",
      "mask": false,
      "description": "Query database settings."
    },
    {
      "name": "Sync Misc",
      "key": "SYNC_CONFIG_MISC",
      "value": "false",
      "mask": false,
      "description": "Misc settings."
    },
    {
      "name": "Sync Debug",
      "key": "SYNC_CONFIG_DEBUG",
      "value": "false",
      "mask": false,
      "description": "Debug settings."
    },
    {
      "name": "Sync DHCP Leases",
      "key": "SYNC_GRAVITY_DHCP_LEASES",
      "value": "false",
      "mask": false,
      "description": "DHCP leases."
    },
    {
      "name": "Sync Groups",
      "key": "SYNC_GRAVITY_GROUP",
      "value": "true",
      "mask": false,
      "description": "Groups."
    },
    {
      "name": "Sync Block Lists",
      "key": "SYNC_GRAVITY_AD_LIST",
      "value": "true",
      "mask": false,
      "description": "Block lists (adlists)."
    },
    {
      "name": "Sync Block List Groups",
      "key": "SYNC_GRAVITY_AD_LIST_BY_GROUP",
      "value": "true",
      "mask": false,
      "description": "Block list group assignments."
    },
    {
      "name": "Sync Allow/Deny Lists",
      "key": "SYNC_GRAVITY_DOMAIN_LIST",
      "value": "true",
      "mask": false,
      "description": "Allow and deny lists (exact and regex)."
    },
    {
      "name": "Sync Allow/Deny Groups",
      "key": "SYNC_GRAVITY_DOMAIN_LIST_BY_GROUP",
      "value": "true",
      "mask": false,
      "description": "Allow/deny list group assignments."
    },
    {
      "name": "Sync Clients",
      "key": "SYNC_GRAVITY_CLIENT",
      "value": "true",
      "mask": false,
      "description": "Clients."
    },
    {
      "name": "Sync Client Groups",
      "key": "SYNC_GRAVITY_CLIENT_BY_GROUP",
      "value": "true",
      "mask": false,
      "description": "Client group assignments."
    }
  ],
  "devices": [],
  "gpus": []
}