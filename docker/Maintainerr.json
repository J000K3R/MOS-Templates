{
  "name": "Maintainerr",
  "repo": "ghcr.io/maintainerr/maintainerr:latest",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --user 500:500",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:6246]/",
  "readme_url": "https://j000k3r.github.io/MOS-Templates/docs/Templates/Docker/Maintainerr.html",
  "icon": "https://raw.githubusercontent.com/J000K3R/MOS-Templates/main/icons/maintainerr.png",
  "category": [ "Media" ],
  "project": "https://github.com/Maintainerr/Maintainerr",
  "support": "https://github.com/Maintainerr/Maintainerr/issues",
  "description": "Maintainerr is a smart media library management tool that keeps your Plex, Jellyfin or Emby library organized automatically. It removes duplicates, prunes old content and manages collections based on custom rules you define.",
  "donate": "https://github.com/Maintainerr/Maintainerr#support",
  "paths": [
    {
      "name": "Data",
      "mode": "rw",
      "host": "/mnt/cache/appdata/maintainerr",
      "container": "/opt/data",
      "description": "Maintainerr configuration, database and logs. Must be writable by UID 1000:1000."
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "protocol": "tcp",
      "host": "6246",
      "container": "6246",
      "description": "Maintainerr Web interface port."
    }
  ],
  "variables": [
    {
      "name": "TZ",
      "key": "TZ",
      "value": "Europe/Vienna",
      "mask": false,
      "description": "Timezone for the container."
    },
    {
      "name": "UI_PORT",
      "key": "UI_PORT",
      "value": "6246",
      "mask": false,
      "description": "Web UI listen port."
    }
  ],
  "devices": [],
  "gpus": []
}
