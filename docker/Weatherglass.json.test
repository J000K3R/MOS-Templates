{
  "name": "Weatherglass",
  "repo": "ghcr.io/j000k3r/weatherglass:dev",
  "network": "bridge",
  "custom_ip": null,
  "default_shell": "sh",
  "privileged": false,
  "extra_parameters": "--restart=unless-stopped --cap-add=NET_RAW",
  "post_parameters": null,
  "web_ui_url": "http://[IP]:[PORT:8080]/",
  "readme_url": "https://j000k3r.github.io/MOS-Templates/docs/Templates/Docker/Weatherglass.html",
  "icon": "https://raw.githubusercontent.com/J000K3R/MOS-Templates/main/icons/weatherglass.png",
  "category": [ "Monitoring" ],
  "project": "https://github.com/j000k3r/weatherglass",
  "support": "https://github.com/j000k3r/weatherglass/issues",
  "description": "Weatherglass is a small self-hosted watchdog for your homelab. It probes your services on a schedule, keeps their history in a single SQLite file, draws the graphs, and tells you when something breaks. Sensors for HTTP, TCP, TLS certificates, ping, DNS, Docker containers and SNMP; alerts over Telegram, Matrix, ntfy, Slack, Discord or a webhook.",
  "paths": [
    {
      "name": "Appdata",
      "mode": "rw",
      "host": "/mnt/cache/appdata/weatherglass",
      "container": "/data",
      "description": "SQLite database, its write-ahead log, and weatherglass.yaml."
    }
  ],
  "ports": [
    {
      "name": "WebUI",
      "protocol": "tcp",
      "host": "8080",
      "container": "8080",
      "description": "Weatherglass web interface and dashboard."
    }
  ],
  "variables": [
    {
      "name": "Base URL",
      "key": "WEATHERGLASS_BASE_URL",
      "value": "",
      "mask": false,
      "description": "Optional. The address you reach the dashboard on, e.g. http://192.168.1.10:8080. Alert messages link back to it; empty means no link is added. Type it out in full — [IP] and [PORT] are not substituted here."
    },
    {
      "name": "Log Level",
      "key": "WEATHERGLASS_LOG_LEVEL",
      "value": "info",
      "mask": false,
      "description": "debug, info, warn or error."
    },
    {
      "name": "Admin Password",
      "key": "WEATHERGLASS_ADMIN_PASSWORD",
      "value": "",
      "mask": true,
      "description": "Optional. Skips the setup screen on a fresh database; ignored once a password has been stored."
    }
  ],
  "devices": [],
  "gpus": []
}
